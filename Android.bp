java_library {
    name: "RevampedFMRadio_static",
    srcs: [
        "src/**/*.java",
    ],
    exclude_srcs: [
        "src/com/android/fmradio/*Activity.java",
        "src/com/android/fmradio/dialogs/*.java",
        "src/com/android/fmradio/views/*.java",
    ],
}

android_app {
    name: "RevampedFMRadio",
    
    srcs: ["src/**/*.java"],
    
    manifest: "AndroidManifest.xml",
    
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    
    overrides: ["FMRadio"],
    
    jni_libs: ["libfmjni"],
    
    static_libs: [
        "androidx.cardview_cardview",
    ],
    
    use_embedded_native_libs: true,
    
    optimize: {
        enabled: false,
    },
    
    required: ["privapp_whitelist_com.android.fmradio_revamped.xml"],
}

prebuilt_etc {
    name: "privapp_whitelist_com.android.fmradio_revamped.xml",
    src: "privapp_whitelist_com.android.fmradio.xml",
    sub_dir: "permissions",
}
